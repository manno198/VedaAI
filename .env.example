# Vision extraction — reads the question paper & handwritten answer sheet
# images and produces bounding boxes. Groq has no vision-capable chat model
# at the time of writing, so this step uses Gemini's free tier.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Grading — text-only (question text + transcribed answer -> score/feedback).
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default models.
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b
